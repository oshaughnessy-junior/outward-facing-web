    <circle cx="560" cy="110" r="38"/>
  </g>
  <g class="research-map-science" fill="none" stroke="currentColor" stroke-width="2">
    <ellipse cx="150" cy="62" rx="22" ry="10" transform="rotate(-30 150 62)"/>
    <circle cx="144" cy="64" r="4"/><circle cx="158" cy="59" r="5"/>
  </g>
  <g class="research-map-ai" fill="none" stroke="currentColor" stroke-width="2">
    <path d="M136 166L150 145L164 166Z"/><circle cx="136" cy="166" r="4"/><circle cx="150" cy="145" r="4"/><circle cx="164" cy="166" r="4"/>
