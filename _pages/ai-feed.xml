<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0"><channel><title>{{ site.title | xml_escape }} — AI, Agents &amp; Reproducibility</title><link>{{ site.url | xml_escape }}{{ site.baseurl | xml_escape }}/ai-agents/</link><description>AI and computational reproducibility research</description>{% for post in site.posts %}{% if site.data.lane_posts.ai contains post.slug and post.external_source == nil %}<item><title>{{ post.title | xml_escape }}</title><link>{{ site.url | xml_escape }}{{ site.baseurl | xml_escape }}{{ post.url | xml_escape }}</link><guid>{{ site.url | xml_escape }}{{ site.baseurl | xml_escape }}{{ post.url | xml_escape }}</guid><pubDate>{{ post.date | date_to_rfc822 }}</pubDate><description>{{ post.excerpt | strip_html | strip_newlines | xml_escape }}</description></item>{% endif %}{% endfor %}</channel></rss>
