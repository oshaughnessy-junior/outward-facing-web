<rss version="2.0"><channel><title>{{ site.title | xml_escape }} — Astrophysics</title><link>{{ site.url | xml_escape }}{{ site.baseurl | xml_escape }}/astrophysics/</link><description>Gravitational-wave astronomy and astrophysics</description>{% for post in site.posts %}{% unless site.data.lane_posts.ai contains post.slug or post.external_source != nil %}<item><title>{{ post.title | xml_escape }}</title><link>{{ site.url | xml_escape }}{{ site.baseurl | xml_escape }}{{ post.url | xml_escape }}</link><guid>{{ site.url | xml_escape }}{{ site.baseurl | xml_escape }}{{ post.url | xml_escape }}</guid><pubDate>{{ post.date | date_to_rfc822 }}</pubDate><description>{{ post.excerpt | strip_html | strip_newlines | xml_escape }}</description></item>{% endunless %}{% endfor %}</channel></rss>
